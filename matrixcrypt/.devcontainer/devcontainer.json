{
  "name": "MatrixCrypt (Java 21)",
  "image": "mcr.microsoft.com/devcontainers/java:21",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "MatrixCrypt", "onAutoForward": "openBrowser" }
  },
  "postCreateCommand": "chmod +x run.sh",
  "customizations": {
    "vscode": { "extensions": ["vscjava.vscode-java-pack"] }
  }
}
